# Source files (only need compiled dist/)
src/**
*.ts
tsconfig.json

# Development files. vsce matches a bare `*.map` at the top level only, so
# the recursive forms are required to keep source maps and type declarations
# out of every directory under dist/.
.gitignore
.eslintrc*
**/*.map
**/*.d.ts
**/*.d.ts.map

# Test files & artifacts
**/*.test.js
**/*.test.ts
tests/**
coverage/**
test-results/**
playwright.config.ts
vitest.config.ts
tsconfig.test.json
tsconfig.playwright.json
scripts/**
*.vsix

# Runtime/test state is never part of a distributable extension. Tests may
# create this directory under the package cwd; excluding it prevents local
# pipeline context, retrospectives, and issue metadata from leaking into a VSIX.
.nightgauge/**

# Documentation: README.md, CHANGELOG.md and LICENSE are all packaged on
# purpose — the Marketplace renders them as the Details, Changelog and License
# tabs of the listing. Excluding CHANGELOG.md drops the Changelog tab entirely.

# Node modules
**/node_modules/**

# Plugin mirror: only the skill/command sources are runtime assets. Lockfiles,
# test suites, helper scripts and test config are contributor material.
dist/claude-plugins/**/package-lock.json
dist/claude-plugins/**/tests/**
dist/claude-plugins/**/*.py
dist/claude-plugins/**/vitest.config.ts

# Stale Go binary — BinaryResolver loads the binary from dist/bin/ (bundled by
# dev-install.sh). A root-level bin/ is dead weight that ships ~15MB and misleads
# binary-path triage. Never package it.
bin/**

# Other
.vscode/**
.vscode-test/**
