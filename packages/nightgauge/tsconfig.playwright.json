{
  // The browser-driven webview tier (#499).
  //
  // Split from tsconfig.test.json for one reason: this code runs in a page.
  // `page.evaluate` callbacks touch `document` and `window`, so the tier needs
  // the DOM lib — and giving the DOM to the node-side vitest tree would hide
  // exactly the environment confusion a typecheck is supposed to surface.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Typecheck-only, same as tsconfig.test.json: no declaration emit, so the
    // inherited `declaration: true` (and its TS2883 nameability constraint on
    // vitest 5's mock inferences) is switched off here as well.
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["tests/playwright/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
