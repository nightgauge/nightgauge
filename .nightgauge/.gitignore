# Nightgauge Pipeline — Generated Artifacts
# This file is managed by the Nightgauge extension and should be committed.
# It prevents pipeline-generated files from polluting git status.
#
# Files that ARE tracked (committed):
#   config.yaml           — repository-wide pipeline configuration
#   .gitignore            — this file
#   */.gitkeep            — preserve directory structure
# nightgauge-gitignore-version: 11

# ─── Pipeline context, state, and execution data ─────────────────────
pipeline/*
!pipeline/.gitkeep
!pipeline/history/
pipeline/history/*
!pipeline/history/.gitkeep

# ─── Feature plans (generated by feature-planning stage) ─────────────
plans/*
!plans/.gitkeep

# ─── Session and execution logs ──────────────────────────────────────
logs/*
!logs/.gitkeep

# ─── Analysis, experiments, and brownfield reports ───────────────────
# Anchored with / so it only matches .nightgauge/analysis/, not pipeline/analysis/
/analysis/

# ─── Brownfield assessment history ──────────────────────────────────
# Anchored with / so it only matches .nightgauge/history/, not pipeline/history/
/history/

# ─── Root-level transient files ─────────────────────────────────────
/state.json
/.refresh-trigger
/config.local.yaml
/config.yaml.tmp
/complexity-model.yaml
/outcome-recovery.jsonl
/cross-project-patterns.json
/saved-queries.yaml
# Field IDs are stored in config.yaml (project.fields section)
# Legacy project-field-mappings.json is no longer used
/project-field-mappings.json

# ─── Autonomous scheduler state ─────────────────────────────────────
/autonomous/

# ─── Skill usage telemetry (local, per-machine) ─────────────────────
/skills/

# ─── Skill evaluation runs (transient; baseline.jsonl is the tracked
# reference — see docs/SKILL_EVALUATION.md) ──────────────────────────
/skill-evals/*
!/skill-evals/baseline.jsonl

# ─── Model evaluation runs (transient by default — the eval SDK writes
# here, and mock runs carry no evidential weight). A live run cited by a
# spike or ADR is promoted to evidence/ and tracked: live agentic runs are
# nondeterministic, so they cannot be re-derived, only re-purchased.
# See docs/MODEL_EVALUATION.md. ──────────────────────────────────────
/model-evals/*
!/model-evals/evidence/

# ─── Pipeline queue state ───────────────────────────────────────────
pipeline/queue-state.json

# ─── Documentation watch snapshots (fetched page hashes) ──────────────
/doc-snapshots/

# ─── Health telemetry (gate metrics, trend data) ─────────────────────
/health/

# ─── Adapter usage readings (last-seen provider quota, per machine) ──
# The Claude CLI reports its rate-limit utilization only while streaming, so
# the last reading per window is cached here for the status-bar meter to
# sample at rest. Per-machine, per-account runtime state — never shared.
/usage/

# ─── Action Center decision requests (ADR 015) ───────────────────────
# Cards are produced locally by the attention sweeps, carry local run ids,
# and are resolved/auto-resolved against local state. Per-machine runtime
# state, exactly like /health/ and /autonomous/ — never shared via git.
/attention/
# The coverage snapshot the sweep writes beside the cards. Same runtime
# class, but it sits at .nightgauge/ root so /attention/ never matched it.
/attention-coverage.json

# ─── Write-containment records (#129) ────────────────────────────────
# Per-run capture of out-of-worktree writes plus attributed.json. Local
# forensic state tied to specific run ids; regenerated every run.
/containment/

# ─── Knowledge base (scaffolded per-issue, local pipeline data) ──────
/knowledge/

# ─── Auto-retro failure reports (local diagnostics) ─────────────────
/retros/

# ─── Generated reports (backlog triage, health, security, etc.) ─────
/backlog-*.md
/triage/
# Per-machine session state the backlog orchestrator rewrites at every
# issue boundary — same runtime class as /autonomous/ and /attention/.
/session-handoff.md
/health-report.json
/security-audit.json
/modernization-plan.json
/dep-modernize-report.json

# ─── Scheduled discovery state (release-watch, improvement runs) ─────
# Produced on a GitHub Actions runner by release-watchdog.yml and
# continuous-improvement.yml, published to the discovery-state branch, and
# fetched into a checkout by scripts/discovery-state-sync.sh. Same runtime
# class as /health/ and /attention/: local copies of state owned elsewhere.
#
# These lines used to un-ignore /release-watch/ with the note "state file —
# shared across team", which described a design that could not work: the main
# branch requires a pull request, so no workflow can push a daily state commit,
# and no producer for these files existed at all until #753.
/release-watch/
/improvement-runs/
