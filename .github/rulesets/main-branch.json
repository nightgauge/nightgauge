{
  "name": "main-branch-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Go build & test"
          },
          {
            "context": "SDK build & test"
          },
          {
            "context": "VSCode build & test"
          },
          {
            "context": "Security & license gates"
          },
          {
            "context": "lint"
          },
          {
            "context": "link-check"
          },
          {
            "context": "publication boundary (allowlist, fail-closed)"
          },
          {
            "context": "credential scan (tree + full history)"
          },
          {
            "context": "cla"
          },
          {
            "context": "Analyze (go)"
          },
          {
            "context": "Analyze (javascript-typescript)"
          },
          {
            "context": "CodeQL"
          },
          {
            "context": "Playwright webview tests"
          },
          {
            "context": "VSCode host smoke tests"
          }
        ]
      }
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    },
    {
      "parameters": {
        "check_response_timeout_minutes": 60,
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 3,
        "max_entries_to_merge": 3,
        "merge_method": "SQUASH",
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 5
      },
      "type": "merge_queue"
    }
  ]
}
